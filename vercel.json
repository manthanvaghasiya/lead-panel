{
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(sw.js|workbox-(.*).js|index.html|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/_/backend/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|_/backend/).*)",
      "destination": "/index.html"
    }
  ]
}
